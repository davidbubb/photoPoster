# Required
PORT=3000
APP_PASSWORD=changeme

# Facebook Page credentials
# Obtain a long-lived Page Access Token from Meta Developer Console
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_page_access_token

# Optional – Facebook Graph API version (defaults to v19.0)
FB_GRAPH_API_VERSION=v19.0

# Optional – upload limits (defaults shown)
MAX_IMAGES=5
MAX_FILE_SIZE_MB=10
